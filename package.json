{
  "name": "orbita-game-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node server/src/index.js",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "node server/src/index.js",
    "test": "npm --workspace client test && npm --workspace server test && npm --workspace shared test",
    "lint": "eslint client server shared",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
